{
  "name": "no-fomo",
  "version": "0.1.0",
  "private": true,
  "description": "Let AI watch the reels. Your Instagram saves and any account, turned into knowledge on your own computer.",
  "license": "MIT",
  "homepage": "https://github.com/no-fomo/no-fomo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-fomo/no-fomo.git"
  },
  "bugs": "https://github.com/no-fomo/no-fomo/issues",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @no-fomo/server dev\" \"pnpm --filter @no-fomo/web dev\"",
    "ext:build": "pnpm --filter @no-fomo/extension build",
    "ext:build:dev": "pnpm --filter @no-fomo/extension build:dev",
    "start": "pnpm --filter @no-fomo/web build && pnpm --filter @no-fomo/server start"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

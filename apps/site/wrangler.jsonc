{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "no-fomo-site",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "upload_source_maps": true,
  "vars": {
    // Public values. Secrets (TURNSTILE_SECRET, CONTACT_TO) are set with `wrangler secret put`.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "MAIL_FROM": "hello@SITE_DOMAIN"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "no-fomo-site",
      // Replace with the id from `wrangler d1 create no-fomo-site` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Sends the owner a copy of each contact message. Only to the verified CONTACT_TO address.
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "FORM_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
